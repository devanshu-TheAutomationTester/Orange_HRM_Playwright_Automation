{
  "name": "orangehrm-playwright-automation",
  "version": "2.0.0",
  "description": "OrangeHRM Employee Lifecycle automation with Playwright Test: fixtures, API-seeded independent tests, role-based access checks, UI + API cross-checks",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test --grep @api",
    "test:rbac": "playwright test --grep @rbac",
    "test:p1": "playwright test --grep @p1",
    "test:demo": "cross-env TEST_ENV=demo playwright test",
    "test:qa": "cross-env TEST_ENV=qa playwright test",
    "test:staging": "cross-env TEST_ENV=staging playwright test",
    "test:all-browsers": "cross-env BROWSERS=all playwright test",
    "test:flaky-check": "playwright test --repeat-each=5 --retries=0",
    "test:quarantine": "cross-env RUN_QUARANTINED=true playwright test --grep @quarantine --retries=0",
    "test:debug": "playwright test --debug",
    "test:list": "playwright test --list",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "report": "playwright show-report",
    "artifacts:collect": "node scripts/collect-artifacts.js",
    "clean:artifacts": "node scripts/clean-artifacts.js"
  },
  "keywords": [
    "playwright",
    "orangehrm",
    "e2e",
    "qa-automation"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "ajv": "^8.17.1",
    "cross-env": "^10.0.0",
    "dotenv": "^18.0.5",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.2.2",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
