# Copy to .env (Windows: copy .env.example .env). .env and .env.* are git-ignored.
# Per-environment overrides can go in .env.qa / .env.staging (loaded when TEST_ENV matches).

# demo | qa | staging  -> config/environments/<name>.js
TEST_ENV=demo
ORANGEHRM_USERNAME=Admin
ORANGEHRM_PASSWORD=admin123

# Optional: override the environment's URL
# BASE_URL=https://opensource-demo.orangehrmlive.com/web/index.php
# QA_BASE_URL=
# STAGING_BASE_URL=

# false = show the browser window while running locally
HEADLESS=true
# Parallel workers (default comes from the environment file)
# WORKERS=4
# true = keep Playwright traces for passed tests too (failed tests always keep one)
KEEP_TRACE=false
# on | off | retain-on-failure (default: on locally, retain-on-failure in CI)
# VIDEO=on
# debug | info | warn | error  - structured log level printed to the console
LOG_LEVEL=warn
# Run only one data row from test-data/employees.json, e.g. qa-engineer-permanent
EMPLOYEE_KEY=
